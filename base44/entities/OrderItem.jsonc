{
  "name": "OrderItem",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string",
      "description": "Reference to parent order"
    },
    "product_id": {
      "type": "string",
      "description": "Product reference"
    },
    "product_name": {
      "type": "string",
      "description": "Product name"
    },
    "sku": {
      "type": "string",
      "description": "Product SKU"
    },
    "quantity": {
      "type": "number",
      "description": "Quantity ordered"
    },
    "unit_price": {
      "type": "number",
      "description": "Price per unit"
    },
    "vat_rate": {
      "type": "number",
      "description": "VAT rate"
    },
    "line_total": {
      "type": "number",
      "description": "Line total"
    }
  },
  "required": [
    "order_id",
    "product_id",
    "quantity",
    "unit_price",
    "line_total"
  ]
}