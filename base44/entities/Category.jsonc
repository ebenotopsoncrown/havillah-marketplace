{
  "name": "Category",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Category name (e.g., Rice & Flour, Frozen, Drinks, Spices)"
    },
    "description": {
      "type": "string",
      "description": "Category description"
    },
    "parent_category_id": {
      "type": "string",
      "description": "Parent category ID for subcategories"
    },
    "display_order": {
      "type": "number",
      "description": "Order for displaying categories"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether category is active"
    },
    "minimum_stock_level": {
      "type": "number",
      "default": 10,
      "description": "Default minimum stock level for products in this category"
    },
    "icon_url": {
      "type": "string",
      "description": "Custom icon/image URL for the category circle"
    },
    "bg_color": {
      "type": "string",
      "description": "Tailwind background colour class for the icon circle (e.g. bg-green-100)"
    }
  },
  "required": [
    "name"
  ]
}